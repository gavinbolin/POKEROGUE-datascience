{
 "_readme": "Single source of truth for pr_farm17 reward ranking. Edit THIS file; ITEM_PRIORITY.md is regenerated from it. Lower rank = better. Rules are checked top-down, first match wins; 'when' uses named flags (and/or/not). Order: specials first, then tier (MASTER>ROGUE>ULTRA>GREAT>COMMON, read from the card), then rank within tier. 'min_tier' lifts an item to at least that tier (candy/Soothe Bell/vouchers = farm goal items sit at the top of Ultra, below Rogue/Master, as before). Items with rank >= junk_threshold are junk regardless of tier (reroll trigger). The farm reloads this file automatically when it changes.",
 "version": 2,
 "tier_order": {
  "COMMON": 0,
  "GREAT": 1,
  "ULTRA": 2,
  "ROGUE": 3,
  "MASTER": 4,
  "LUXURY": 5
 },
 "junk_threshold": 93,
 "default_rank": 50,
 "specials": {
  "master_ball": -400,
  "role_revive": -300,
  "sword": -290,
  "prism_scale": -290,
  "dna_pair": -250,
  "emergency_heal": -240,
  "mega_bracelet": -400,
  "absolite": -400,
  "mewtwonite": -400
 },
 "special_notes": {
  "master_ball": "Gavin t138u/t140u: Master Ball beats everything; reserved for the wave-200 Eternatus catch every run.",
  "role_revive": "Revive/Max Revive/Sacred Ash when Zacian or secondary fainted",
  "sword": "Rusted/Ancient Sword while Zacian in party",
  "prism_scale": "while secondary is Feebas",
  "dna_pair": "DNA Splicers when unfused Kricketot/Kricketune + Zigzagoon/Linoone",
  "emergency_heal": "Full Restore/Max Potion/heal when Zacian <25% HP and next wave risky"
 },
 "flags": [
  "lure_active",
  "out_of_balls",
  "holding_balls",
  "heal_need",
  "role_low",
  "pp_crit",
  "pp_low",
  "secondary_in_party",
  "ally_dead",
  "zhp_low",
  "zacian_fainted",
  "voucher_crit",
  "emergency"
 ],
 "match_modes": {
  "substring": "name contains",
  "word": "whole word",
  "prefix": "name starts with",
  "prefix_or_substring": "'x ' as prefix, others substring",
  "menu": "'tm' as prefix, others substring",
  "ball": "name ends with ' ball' and contains the pattern"
 },
